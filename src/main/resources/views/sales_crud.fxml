<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.SalesController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="40.0"
              style="-fx-background-color: #a9cec2;"
              BorderPane.alignment="CENTER">
            <children>
                <Label text="SALES REGISTRATION SYSTEM"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <HBox.margin>
                        <Insets left="15.0" />
                    </HBox.margin>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btn_back" mnemonicParsing="false" text="BACK"
                        onAction="#handleBack"
                        style="-fx-background-color: #2F4F4F; -fx-text-fill: white; -fx-padding: 5 15 5 15;">
                    <HBox.margin>
                        <Insets right="15.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <HBox prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #2F3640;">

            <!-- LEFT PANEL: FORM -->
            <VBox prefWidth="400.0" minWidth="400.0" style="-fx-background-color: #3B444C;">
                <padding>
                    <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                </padding>

                <Label text="+ REGISTER NEW SALE"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #A9B7C6;"/>
                <Separator style="-fx-background-color: #6C7A89;">
                    <VBox.margin>
                        <Insets top="5.0" bottom="15.0"/>
                    </VBox.margin>
                </Separator>

                <!-- Client Selection -->
                <Label text="Client:" style="-fx-text-fill: #A9B7C6;"/>
                <ComboBox fx:id="cmb_client" prefWidth="350.0" promptText="Select a client"
                          style="-fx-background-color: #555E67; -fx-prompt-text-fill: #9AA7B7;"/>

                <!-- Product Selection -->
                <Label text="Product:" style="-fx-text-fill: #A9B7C6;">
                    <VBox.margin><Insets top="15.0"/></VBox.margin>
                </Label>
                <ComboBox fx:id="cmb_product" prefWidth="350.0" promptText="Select a product"
                          style="-fx-background-color: #555E67; -fx-prompt-text-fill: #9AA7B7;"
                          onAction="#handleProductSelection"/>

                <!-- Product Info Display -->
                <HBox spacing="10" style="-fx-padding: 5 0 0 0;">
                    <Label fx:id="lbl_product_info" text=""
                           style="-fx-text-fill: #A9B7C6; -fx-font-size: 11px;"/>
                </HBox>

                <!-- Quantity -->
                <Label text="Quantity:" style="-fx-text-fill: #A9B7C6;">
                    <VBox.margin><Insets top="15.0"/></VBox.margin>
                </Label>
                <TextField fx:id="txt_quantity" promptText="Enter quantity"
                           style="-fx-background-color: #555E67; -fx-text-fill: white; -fx-prompt-text-fill: #9AA7B7;"
                           onKeyReleased="#handleQuantityChange"/>

                <!-- Total Preview -->
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                    <Label text="Total:" style="-fx-text-fill: #A9B7C6; -fx-font-weight: bold;"/>
                    <Label fx:id="lbl_total" text="0"
                           style="-fx-text-fill: #27ae60; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Payment Method -->
                <Label text="Payment Method:" style="-fx-text-fill: #A9B7C6;">
                    <VBox.margin><Insets top="15.0"/></VBox.margin>
                </Label>
                <ComboBox fx:id="cmb_payment_method" prefWidth="350.0" promptText="Select payment method"
                          style="-fx-background-color: #555E67; -fx-prompt-text-fill: #9AA7B7;"/>

                <Region VBox.vgrow="ALWAYS" />

                <!-- Register Button -->
                <Button fx:id="btn_register" mnemonicParsing="false" text="REGISTER SALE"
                        onAction="#handleRegisterSale" prefWidth="350.0"
                        style="-fx-background-color: #008B8B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;">
                    <VBox.margin><Insets top="20.0"/></VBox.margin>
                </Button>
            </VBox>

            <!-- RIGHT PANEL: TABLE -->
            <VBox HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                <Label text="RECENT SALES"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #A9B7C6;"/>
                <Separator style="-fx-background-color: #6C7A89;">
                    <VBox.margin>
                        <Insets top="5.0" bottom="15.0"/>
                    </VBox.margin>
                </Separator>

                <TableView fx:id="table_sales" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #3B444C;">
                    <columns>
                        <TableColumn fx:id="col_id" text="ID" prefWidth="50.0" />
                        <TableColumn fx:id="col_client" text="Client" prefWidth="120.0" />
                        <TableColumn fx:id="col_product" text="Product" prefWidth="150.0" />
                        <TableColumn fx:id="col_quantity" text="Qty" prefWidth="60.0" />
                        <TableColumn fx:id="col_unit_price" text="Unit Price" prefWidth="100.0" />
                        <TableColumn fx:id="col_total" text="Total" prefWidth="100.0" />
                        <TableColumn fx:id="col_payment" text="Payment" prefWidth="100.0" />
                        <TableColumn fx:id="col_created_at" text="Date" prefWidth="150.0" />
                    </columns>
                </TableView>

                <!-- Action Buttons -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <VBox.margin><Insets top="15.0"/></VBox.margin>
                    <Button fx:id="btn_delete" mnemonicParsing="false" text="DELETE"
                            onAction="#handleDelete"
                            style="-fx-background-color: #CD5C5C; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button fx:id="btn_refresh" mnemonicParsing="false" text="REFRESH LIST"
                            onAction="#handleRefresh"
                            style="-fx-background-color: #6C7A89; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>