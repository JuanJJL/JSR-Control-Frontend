<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.MainMenuController"
            prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: #ecf0f1;">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: #2c3e50; -fx-padding: 15;">

            <Label text="Sistema JSR Control" textFill="white">
                <font>
                    <Font name="System Bold" size="20.0"/>
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="username_label" text="Bienvenido, Usuario" textFill="white">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>

            <Button fx:id="logout_button" text="🚪 Cerrar Sesión" onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- MENÚ PRINCIPAL (CENTRO) -->
    <center>
        <VBox alignment="CENTER" spacing="30">

            <Label text="Menú Principal" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <GridPane hgap="30" vgap="30" alignment="CENTER">

                <!-- Botón CRUD Usuarios -->
                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);"
                      GridPane.columnIndex="0" GridPane.rowIndex="0">

                    <Label text="👥" style="-fx-font-size: 48;"/>
                    <Button fx:id="usuarios_button" text="Manejo Usuarios" onAction="#openUserCrud"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15 30; -fx-font-size: 14;"
                            prefWidth="200"/>
                </VBox>

                <!-- Botón CRUD Productos -->
                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);"
                      GridPane.columnIndex="1" GridPane.rowIndex="0">

                    <Label text="📦" style="-fx-font-size: 48;"/>
                    <Button fx:id="productos_button" text="CRUD Productos" onAction="#openProducts"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15 30; -fx-font-size: 14;"
                            prefWidth="200"/>
                </VBox>

                <!-- Botón CRUD Clientes -->
                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);"
                      GridPane.columnIndex="0" GridPane.rowIndex="1">

                    <Label text="👤" style="-fx-font-size: 48;"/>
                    <Button fx:id="clientes_button" text="CRUD Clientes" onAction="#openSales"
                            style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15 30; -fx-font-size: 14;"
                            prefWidth="200"/>
                </VBox>

            </GridPane>

        </VBox>
    </center>

</BorderPane>