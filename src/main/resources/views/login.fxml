<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!-- Fondo principal con color gris-azulado -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.LoginController"
           style="-fx-background-color: #6B8A8C;"
           prefHeight="600.0" prefWidth="800.0">

    <!-- Contenedor del formulario con fondo gris oscuro y bordes redondeados -->
    <VBox alignment="CENTER"
          spacing="15"
          style="-fx-background-color: #5A6C6D; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);"
          maxWidth="350.0"
          maxHeight="400.0">

        <padding>
            <Insets top="40" right="50" bottom="40" left="50"/>
        </padding>

        <!-- Título "Bienvenido" -->
        <Label text="Bienvenido" textFill="white">
            <font>
                <Font name="System Bold" size="32.0"/>
            </font>
            <VBox.margin>
                <Insets bottom="20"/>
            </VBox.margin>
        </Label>

        <!-- Campo de Usuario -->
        <TextField fx:id="username_field"
                   promptText="Usuario"
                   alignment="CENTER"
                   style="-fx-background-color: white;
                          -fx-background-radius: 5;
                          -fx-padding: 12;
                          -fx-font-size: 14px;
                          -fx-text-fill: #333333;
                          -fx-prompt-text-fill: #666666;"
                   prefWidth="250.0"/>

        <!-- Campo de Contraseña -->
        <PasswordField fx:id="password_field"
                       promptText="Contraseña"
                       alignment="CENTER"
                       style="-fx-background-color: white;
                              -fx-background-radius: 5;
                              -fx-padding: 12;
                              -fx-font-size: 14px;
                              -fx-text-fill: #333333;
                              -fx-prompt-text-fill: #666666;"
                       prefWidth="250.0"/>

        <!-- Botón de Login con color verde menta -->
        <Button text="Login"
                onAction="#handleLogin"
                style="-fx-background-color: #A8D5BA;
                       -fx-text-fill: #2C3E50;
                       -fx-font-weight: bold;
                       -fx-background-radius: 5;
                       -fx-font-size: 14px;
                       -fx-cursor: hand;"
                prefWidth="250.0"
                prefHeight="40">
            <font>
                <Font name="System Bold" size="14.0"/>
            </font>
            <VBox.margin>
                <Insets top="10"/>
            </VBox.margin>
        </Button>

    </VBox>

</StackPane>